{
  "version": 1,
  "presets": {
    "mask-reveal": {
      "kind": "entrada",
      "description": "El texto se descubre tras una máscara horizontal.",
      "ease": "power3.out",
      "duration": 0.9,
      "gsap": {
        "from": { "clipPath": "inset(0 100% 0 0)" },
        "to": { "clipPath": "inset(0 0% 0 0)" }
      }
    },
    "stagger-words": {
      "kind": "entrada",
      "description": "Palabras que suben en cascada. Requiere partir el texto en <span class=w> a mano (sin SplitText).",
      "ease": "power3.out",
      "duration": 0.7,
      "stagger": 0.06,
      "gsap": {
        "from": { "y": "100%", "opacity": 0 },
        "to": { "y": "0%", "opacity": 1 }
      }
    },
    "blur-in": {
      "kind": "entrada",
      "description": "Aparición con desenfoque. Firma de la personalidad tech.",
      "ease": "circ.out",
      "duration": 0.8,
      "gsap": {
        "from": { "opacity": 0, "filter": "blur(12px)" },
        "to": { "opacity": 1, "filter": "blur(0px)" }
      }
    },
    "spring-pop": {
      "kind": "entrada",
      "description": "Pop con rebote. Firma de la personalidad juguetón.",
      "ease": "back.out(1.7)",
      "duration": 0.7,
      "gsap": {
        "from": { "scale": 0.6, "opacity": 0 },
        "to": { "scale": 1, "opacity": 1 }
      }
    },
    "slide-stack": {
      "kind": "entrada",
      "description": "Tarjetas que suben apiladas en cascada.",
      "ease": "power3.out",
      "duration": 0.6,
      "stagger": 0.08,
      "gsap": {
        "from": { "y": 60, "opacity": 0 },
        "to": { "y": 0, "opacity": 1 }
      }
    },
    "scale-fade": {
      "kind": "entrada",
      "description": "Zoom suave. Comodín corporativo.",
      "ease": "power2.out",
      "duration": 0.8,
      "gsap": {
        "from": { "scale": 0.92, "opacity": 0 },
        "to": { "scale": 1, "opacity": 1 }
      }
    },
    "wipe": {
      "kind": "entrada",
      "description": "Barrido lateral con origen a la izquierda.",
      "ease": "power3.inOut",
      "duration": 0.7,
      "gsap": {
        "from": { "scaleX": 0, "transformOrigin": "left center" },
        "to": { "scaleX": 1 }
      }
    },
    "typewriter": {
      "kind": "entrada",
      "description": "Máquina de escribir por caracteres (spans a mano, stagger corto).",
      "ease": "none",
      "duration": 0.04,
      "stagger": 0.035,
      "gsap": {
        "from": { "opacity": 0 },
        "to": { "opacity": 1 }
      }
    },
    "fade-slide-out": {
      "kind": "salida",
      "description": "Salida estándar: sube y se disuelve.",
      "ease": "power2.in",
      "duration": 0.5,
      "gsap": {
        "to": { "y": -30, "opacity": 0 }
      }
    },
    "blur-out": {
      "kind": "salida",
      "description": "Salida con desenfoque, pareja de blur-in.",
      "ease": "power2.in",
      "duration": 0.5,
      "gsap": {
        "to": { "opacity": 0, "filter": "blur(12px)" }
      }
    },
    "pulse": {
      "kind": "énfasis",
      "description": "Latido de escala finito (3 idas y vueltas). CTAs y ofertas.",
      "ease": "sine.inOut",
      "duration": 0.4,
      "gsap": {
        "to": { "scale": 1.06, "yoyo": true, "repeat": 3 }
      }
    },
    "highlight-sweep": {
      "kind": "énfasis",
      "description": "Barrido de resaltador tras la palabra clave.",
      "ease": "power3.out",
      "duration": 0.6,
      "gsap": {
        "from": { "scaleX": 0, "transformOrigin": "left center" },
        "to": { "scaleX": 1 }
      }
    },
    "underline-draw": {
      "kind": "énfasis",
      "description": "Subrayado que se dibuja de izquierda a derecha.",
      "ease": "power3.out",
      "duration": 0.6,
      "gsap": {
        "from": { "scaleX": 0, "transformOrigin": "left center" },
        "to": { "scaleX": 1 }
      }
    },
    "counter-up": {
      "kind": "énfasis",
      "description": "Contador 0→N con onUpdate (seek-safe: función pura del tiempo). Métricas y precios.",
      "ease": "power2.out",
      "duration": 1.5,
      "gsap": {
        "to": { "value": 100 }
      }
    },
    "number-roll": {
      "kind": "énfasis",
      "description": "Tira vertical de dígitos que rueda hasta el número. Sin callbacks.",
      "ease": "power3.inOut",
      "duration": 1.2,
      "gsap": {
        "to": { "y": "-7em" }
      }
    },
    "shake": {
      "kind": "énfasis",
      "description": "Sacudida horizontal en 5 keyframes. Errores y alertas.",
      "ease": "none",
      "duration": 0.4,
      "gsap": {
        "to": { "keyframes": [{ "x": -10 }, { "x": 10 }, { "x": -6 }, { "x": 6 }, { "x": 0 }] }
      }
    },
    "glow": {
      "kind": "énfasis",
      "description": "Pulso de opacidad sobre texto con text-shadow fijo. Títulos nocturnos.",
      "ease": "sine.inOut",
      "duration": 0.6,
      "gsap": {
        "from": { "opacity": 0.55 },
        "to": { "opacity": 1, "yoyo": true, "repeat": 1 }
      }
    },
    "device-mockup-scroll": {
      "kind": "escena",
      "description": "Mockup de teléfono que entra y desplaza su pantalla. Promo de app.",
      "ease": "power3.out",
      "duration": 1.2,
      "gsap": {
        "from": { "y": 80, "opacity": 0 },
        "to": { "y": -160 }
      }
    },
    "browser-scroll": {
      "kind": "escena",
      "description": "Ventana de navegador con scroll de página. Promo de web/SaaS.",
      "ease": "power3.out",
      "duration": 1.2,
      "gsap": {
        "from": { "y": 60, "opacity": 0 },
        "to": { "y": -180 }
      }
    },
    "card-carousel": {
      "kind": "escena",
      "description": "Tarjetas que entran y salen en carrusel lateral.",
      "ease": "power3.out",
      "duration": 0.6,
      "stagger": 0.5,
      "gsap": {
        "from": { "x": 120, "opacity": 0 },
        "to": { "x": -120, "opacity": 0 }
      }
    },
    "feature-grid": {
      "kind": "escena",
      "description": "Grilla 2x2 de features con entrada escalonada.",
      "ease": "power2.out",
      "duration": 0.6,
      "stagger": 0.12,
      "gsap": {
        "from": { "scale": 0.9, "opacity": 0 },
        "to": { "scale": 1, "opacity": 1 }
      }
    },
    "split-screen": {
      "kind": "escena",
      "description": "Dos mitades que se abren desde el centro. Antes/después.",
      "ease": "power3.inOut",
      "duration": 0.7,
      "gsap": {
        "from": { "scaleX": 0 },
        "to": { "scaleX": 1 }
      }
    },
    "logo-build": {
      "kind": "escena",
      "description": "Construcción de logo: marca con pop y wordmark con reveal. Intros.",
      "ease": "back.out(1.7)",
      "duration": 0.7,
      "gsap": {
        "from": { "scale": 0 },
        "to": { "scale": 1 }
      }
    },
    "kinetic-type": {
      "kind": "escena",
      "description": "Tres líneas cinéticas en cascada con acento de color.",
      "ease": "power4.out",
      "duration": 0.7,
      "stagger": 0.15,
      "gsap": {
        "from": { "y": "110%" },
        "to": { "y": "0%" }
      }
    }
  }
}
